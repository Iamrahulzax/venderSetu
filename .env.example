# ==========================================
# VenderSetu — Environment Configuration
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/vendersetu

# JSON Web Token Secret for Authentication
JWT_SECRET=vendersetu_super_secure_jwt_secret_campus_2026
JWT_EXPIRES_IN=7d

# Razorpay India Payment Gateway Credentials (Sandbox / Test Mode)
# Replace with your actual Razorpay keys for live transactions
RAZORPAY_KEY_ID=rzp_test_campus_vendersetu
RAZORPAY_KEY_SECRET=rzp_secret_dummy_campus_key

# Client Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development
